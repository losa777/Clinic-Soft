# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# სკანერის აგენტის ინსტალატორი (npm run scanner:build)
/scanner-agent/dist/

# ბაზის ექსპორტი (npm run db:export) — პაციენტების მონაცემები, git-ში არ შედის
/backups/

# პაციენტების ფაილები (storage/documents) — პერსონალური მონაცემები, git-ში არ შედის
/storage/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# HTTPS: კლინიკის CA და სერვერის სერტიფიკატი (npm run https:setup) — გასაღებები საიდუმლოა
/certs/
/https-installer/dist/
