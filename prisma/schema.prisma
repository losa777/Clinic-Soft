// ცხრილებს ქმნის scripts/setup-db.ts (npm run db:setup).
// ამ ფაილში ცვლილებისას განაახლეთ ის სკრიპტიც.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(30)
  name        String           @db.VarChar(50)
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

/// უფლება (მაგ. invoices.create). სია: src/lib/permissions.ts; ბაზაში იწერება npm run db:setup-ით.
model Permission {
  id    Int              @id @default(autoincrement())
  code  String           @unique(map: "uq_permissions_code") @db.VarChar(50)
  name  String           @db.VarChar(100)
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// კლინიკის პარამეტრები (key → value), მაგ. ქვითრის რეკვიზიტები. სია: src/modules/finance/settings.ts.
model Setting {
  key   String @id @db.VarChar(50)
  value String @db.Text

  @@map("settings")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  roleId       Int      @map("role_id")
  isActive     Boolean  @default(true) @map("is_active")
  /// პაროლის შეცვლისას იზრდება — ძველი სესიები (JWT-ში sv) მაშინვე უქმდება
  sessionVersion    Int       @default(0) @map("session_version")
  passwordChangedAt DateTime? @map("password_changed_at") @db.DateTime(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  role         Role     @relation(fields: [roleId], references: [id])

  patientsCreated   Patient[]         @relation("PatientCreatedBy")
  patientsUpdated   Patient[]         @relation("PatientUpdatedBy")
  documentsUploaded PatientDocument[]

  doctorProfile         Doctor?
  appointmentsCreated   Appointment[] @relation("AppointmentCreatedBy")
  appointmentsUpdated   Appointment[] @relation("AppointmentUpdatedBy")
  appointmentsCancelled Appointment[] @relation("AppointmentCancelledBy")

  priceChanges       ServicePriceHistory[]
  insurancesCreated  PatientInsurance[]
  invoiceDoctor      Invoice[]             @relation("InvoiceDoctor")
  invoicesCreated    Invoice[]             @relation("InvoiceCreatedBy")
  invoicesCancelled  Invoice[]             @relation("InvoiceCancelledBy")
  paymentsCreated    Payment[]
  cashShifts         CashShift[]
  receiptPrints      ReceiptPrint[]

  allergiesCreated     PatientAllergy[]
  conditionsCreated    PatientCondition[]
  medicationsCreated   PatientMedication[]
  encounters           Encounter[]         @relation("EncounterDoctor")
  doctorTemplates      DoctorTemplate[]
  prescriptionsCreated Prescription[]
  ordersCreated        MedicalOrder[]      @relation("OrderCreatedBy")
  ordersPerformed      MedicalOrder[]      @relation("OrderPerformedBy")
  documentsCreated     MedicalDocument[]
  signatures           DocumentSignature[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  conversationsCreated Conversation[]       @relation("ConversationCreatedBy")
  chatMemberships      ConversationMember[]
  messagesSent         Message[]            @relation("MessageSender")
  messagesTargeted     Message[]            @relation("MessageTarget")
  messageRevisions     MessageRevision[]
  favorites            UserFavorite[]       @relation("FavoriteOwner")
  favoritedBy          UserFavorite[]       @relation("FavoriteTarget")
  presence             UserPresence?
  chatSettings         UserChatSettings?

  inventoryReceipts  InventoryReceipt[]
  inventoryMovements InventoryMovement[]

  @@index([roleId])
  @@map("users")
}

enum Gender {
  male
  female
}

enum MaritalStatus {
  married
  single
  divorced
  widowed
}

/// lab_result / imaging — კვლევის შედეგი (ლაბორანტი ტვირთავს); medical — გენერირებული სამედიცინო დოკუმენტი (PDF)
enum DocumentType {
  id_card
  passport
  insurance
  other
  lab_result
  imaging
  medical
}

model Patient {
  id            Int            @id @default(autoincrement())
  personalId    String         @unique(map: "uq_patients_personal_id") @map("personal_id") @db.Char(11)
  firstName     String         @map("first_name") @db.VarChar(100)
  lastName      String         @map("last_name") @db.VarChar(100)
  fatherName    String?        @map("father_name") @db.VarChar(100)
  firstNameEn   String         @map("first_name_en") @db.VarChar(100)
  lastNameEn    String         @map("last_name_en") @db.VarChar(100)
  birthDate     DateTime       @map("birth_date") @db.Date
  gender        Gender
  /// სამედიცინო ბარათის ნომერი წლის მიხედვით (6914/2026) — ენიჭება მიღების დაწყებისას
  cardNumber    Int?           @map("card_number")
  cardYear      Int?           @map("card_year") @db.SmallInt
  maritalStatus MaritalStatus? @map("marital_status")
  phone         String?        @db.VarChar(30)
  /// სისხლის ჯგუფი: O+ O- A+ A- B+ B- AB+ AB- (ავსებს ექიმი)
  bloodGroup    String?        @map("blood_group") @db.VarChar(3)
  /// გენერირებული სვეტი (STORED): phone მხოლოდ ციფრებით, ტელეფონით ძებნისთვის. აქ არასოდეს იწერება.
  phoneDigits   String?        @map("phone_digits") @db.VarChar(30)
  email         String?        @db.VarChar(255)
  country       String?        @db.VarChar(100)
  city          String?        @db.VarChar(100)
  actualAddress String?        @map("actual_address") @db.VarChar(255)
  legalAddress  String?        @map("legal_address") @db.VarChar(255)
  workplace     String?        @db.VarChar(255)
  position      String?        @db.VarChar(255)
  education     String?        @db.VarChar(255)
  comment       String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  createdById   Int?           @map("created_by")
  updatedById   Int?           @map("updated_by")
  createdBy     User?          @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?          @relation("PatientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  documents     PatientDocument[]
  appointments  Appointment[]
  insurances    PatientInsurance[]
  invoices      Invoice[]
  allergies        PatientAllergy[]
  conditions       PatientCondition[]
  medications      PatientMedication[]
  encounters       Encounter[]
  prescriptions    Prescription[]
  medicalOrders    MedicalOrder[]
  medicalDocuments MedicalDocument[]
  auditLogs        AuditLog[]

  @@index([lastName, firstName], map: "idx_patients_name")
  @@index([phoneDigits], map: "idx_patients_phone_digits")
  @@index([firstName], map: "idx_patients_first_name")
  @@index([lastNameEn, firstNameEn], map: "idx_patients_name_en")
  @@index([firstNameEn], map: "idx_patients_first_name_en")
  @@index([createdById])
  @@index([updatedById])
  @@map("patients")
  encounterMeasurements EncounterMeasurement[]
  inventoryMovements    InventoryMovement[]
}

/// სერვისების კატეგორია (კონსულტაცია, ლაბორატორია, დიაგნოსტიკა...).
/// orderType — ექიმის დანიშნულების ტიპი ამ კატეგორიის სერვისებზე (null — არ ინიშნება: მაგ. კონსულტაცია).
model ServiceCategory {
  id        Int                 @id @default(autoincrement())
  name      String              @unique(map: "uq_service_categories_name") @db.VarChar(100)
  orderType OrderType?          @map("order_type")
  services  Service[]
  contracts InsuranceContract[]

  @@map("service_categories")
}

/// კლინიკის სერვისები (ფასი ლარში). code — ICD-10 კოდი: არასავალდებულო (null — არ არის), არ არის უნიკალური.
/// არ იშლება — დეაქტივირდება (is_active = 0), რადგან ინვოისებშია გამოყენებული.
model Service {
  id         Int      @id @default(autoincrement())
  code       String?  @db.VarChar(30)
  name       String   @unique(map: "uq_services_name") @db.VarChar(255)
  categoryId Int?     @map("category_id")
  price      Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  category   ServiceCategory?      @relation(fields: [categoryId], references: [id])
  priceHistory ServicePriceHistory[]
  invoiceItems InvoiceItem[]
  contracts    InsuranceContract[]
  consultationDoctors Doctor[]     @relation("DoctorConsultation")
  medicalOrders       MedicalOrder[]
  materials           ServiceMaterial[]

  @@index([code], map: "idx_services_code")
  @@index([categoryId, isActive], map: "idx_services_category")
  @@map("services")
}

/// ფასის ცვლილების ისტორია (ჩანაწერი არ იცვლება და არ იშლება).
model ServicePriceHistory {
  id          Int      @id @default(autoincrement())
  serviceId   Int      @map("service_id")
  oldPrice    Decimal  @map("old_price") @db.Decimal(12, 2)
  newPrice    Decimal  @map("new_price") @db.Decimal(12, 2)
  changedById Int?     @map("changed_by")
  changedAt   DateTime @default(now()) @map("changed_at") @db.DateTime(0)
  service     Service  @relation(fields: [serviceId], references: [id])
  changedBy   User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([serviceId, changedAt], map: "idx_service_price_history_service")
  @@index([changedById])
  @@map("service_price_history")
}

/// მიღების ტიპი: ამბულატორიული ან დღის სტაციონარი
enum VisitType {
  outpatient
  day_hospital
}

model PatientDocument {
  id           Int          @id @default(autoincrement())
  patientId    Int          @map("patient_id")
  docType      DocumentType @map("doc_type")
  title        String       @db.VarChar(255)
  originalName String       @map("original_name") @db.VarChar(255)
  storagePath  String       @map("storage_path") @db.VarChar(255)
  mimeType     String       @map("mime_type") @db.VarChar(100)
  sizeBytes    Int          @map("size_bytes")
  uploadedById Int?         @map("uploaded_by")
  uploadedAt   DateTime     @default(now()) @map("uploaded_at") @db.Timestamp(0)
  patient      Patient      @relation(fields: [patientId], references: [id])
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  orderResults MedicalOrder[]
  medicalDocuments MedicalDocument[]

  @@index([patientId])
  @@index([uploadedById])
  @@map("patient_documents")
}

/// ექიმის სპეციალობა (თერაპევტი, კარდიოლოგი...).
model Specialty {
  id      Int      @id @default(autoincrement())
  name    String   @unique(map: "uq_specialties_name") @db.VarChar(100)
  /// ვიზიტის ფორმაში საერთო ვიტალური (წნევა, პულსი...) ჩანს თუ არა
  showCommonVitals Boolean @default(true) @map("show_common_vitals")
  doctors Doctor[]
  measurements SpecialtyMeasurement[]
  encounters   Encounter[]

  @@map("specialties")
}

/// ექიმის პროფილი ჯავშნებისთვის: მომხმარებელი (როლით „ექიმი“), სპეციალობა, ვიზიტის ხანგრძლივობა.
/// consultationServiceId — ექიმის კონსულტაციის სერვისი: ჯავშნიდან ინვოისში ავტომატურად ჩაჯდება.
model Doctor {
  id                    Int              @id @default(autoincrement())
  userId                Int              @unique(map: "uq_doctors_user_id") @map("user_id")
  specialtyId           Int              @map("specialty_id")
  visitDuration         Int              @default(30) @map("visit_duration") @db.SmallInt
  room                  String?          @db.VarChar(20)
  isActive              Boolean          @default(true) @map("is_active")
  consultationServiceId Int?             @map("consultation_service_id")
  user                  User             @relation(fields: [userId], references: [id])
  specialty             Specialty        @relation(fields: [specialtyId], references: [id])
  consultationService   Service?         @relation("DoctorConsultation", fields: [consultationServiceId], references: [id], onDelete: SetNull)
  schedules             DoctorSchedule[]
  appointments          Appointment[]

  @@index([specialtyId, isActive], map: "idx_doctors_specialty")
  @@index([consultationServiceId])
  @@map("doctors")
}

/// ექიმის სამუშაო გრაფიკი: კვირის დღე (1 — ორშაბათი ... 7 — კვირა) და დრო თბილისის დროით.
/// ერთ დღეს შეიძლება რამდენიმე ინტერვალი ჰქონდეს (მაგ. შესვენებით).
model DoctorSchedule {
  id        Int      @id @default(autoincrement())
  doctorId  Int      @map("doctor_id")
  weekday   Int      @db.TinyInt
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, weekday], map: "idx_doctor_schedules_doctor")
  @@map("doctor_schedules")
}

/// booked → arrived (რეგისტრატურა) → in_progress (ექიმმა დაიწყო მიღება) → completed (ექიმმა დაასრულა); ან cancelled / no_show
enum AppointmentStatus {
  booked
  arrived
  in_progress
  completed
  cancelled
  no_show
}

/// booking — წინასწარი ჯავშანი (სლოტით); walk_in — ცოცხალი რიგი: ინვოისი ექიმით, ჯავშნის გარეშე (სლოტს არ იკავებს)
enum AppointmentSource {
  booking
  walk_in
}

/// ექიმთან ვიზიტის ჯავშანი. დრო ინახება UTC-ში (DATETIME), ჩვენება — Asia/Tbilisi.
/// arrivedAt — პაციენტის მოსვლის დრო („მობრძანდა“): ექიმის რიგი ამით ლაგდება.
model Appointment {
  id            Int               @id @default(autoincrement())
  patientId     Int               @map("patient_id")
  doctorId      Int               @map("doctor_id")
  startTime     DateTime          @map("start_time") @db.DateTime(0)
  endTime       DateTime          @map("end_time") @db.DateTime(0)
  status        AppointmentStatus @default(booked)
  source        AppointmentSource @default(booking)
  arrivedAt     DateTime?         @map("arrived_at") @db.DateTime(0)
  comment       String?           @db.VarChar(1000)
  cancelReason  String?           @map("cancel_reason") @db.VarChar(500)
  cancelledById Int?              @map("cancelled_by")
  cancelledAt   DateTime?         @map("cancelled_at") @db.DateTime(0)
  createdById   Int?              @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedById   Int?              @map("updated_by")
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  patient       Patient           @relation(fields: [patientId], references: [id])
  doctor        Doctor            @relation(fields: [doctorId], references: [id])
  createdBy     User?             @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?             @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  cancelledBy   User?             @relation("AppointmentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  invoices      Invoice[]
  encounter     Encounter?

  @@index([doctorId, startTime], map: "idx_appointments_doctor_start")
  @@index([patientId, startTime], map: "idx_appointments_patient")
  @@index([startTime], map: "idx_appointments_start")
  @@index([createdById])
  @@index([updatedById])
  @@index([cancelledById])
  @@map("appointments")
}

// ─── დაზღვევა ───

model InsuranceCompany {
  id        Int                 @id @default(autoincrement())
  name      String              @unique(map: "uq_insurance_companies_name") @db.VarChar(150)
  isActive  Boolean             @default(true) @map("is_active")
  contracts InsuranceContract[]
  policies  PatientInsurance[]
  invoices  Invoice[]

  @@map("insurance_companies")
}

/// კომპანიის პირობა სერვისზე ან მთელ კატეგორიაზე (ზუსტად ერთი მათგანი). სერვისის პირობა უპირატესია კატეგორიისაზე.
/// limitAmount — დაზღვევის მაქსიმალური წილი სერვისის ერთეულზე (null — ლიმიტის გარეშე).
model InsuranceContract {
  id              Int              @id @default(autoincrement())
  companyId       Int              @map("company_id")
  serviceId       Int?             @map("service_id")
  categoryId      Int?             @map("category_id")
  coveragePercent Decimal          @map("coverage_percent") @db.Decimal(5, 2)
  limitAmount     Decimal?         @map("limit_amount") @db.Decimal(12, 2)
  company         InsuranceCompany @relation(fields: [companyId], references: [id])
  service         Service?         @relation(fields: [serviceId], references: [id])
  category        ServiceCategory? @relation(fields: [categoryId], references: [id])

  @@unique([companyId, serviceId], map: "uq_insurance_contracts_service")
  @@unique([companyId, categoryId], map: "uq_insurance_contracts_category")
  @@index([serviceId])
  @@index([categoryId])
  @@map("insurance_contracts")
}

/// პაციენტის პოლისი. აქტიურია, თუ is_active და დღევანდელი თარიღი valid_from..valid_to შუალედშია.
model PatientInsurance {
  id           Int              @id @default(autoincrement())
  patientId    Int              @map("patient_id")
  companyId    Int              @map("company_id")
  policyNumber String           @map("policy_number") @db.VarChar(50)
  validFrom    DateTime         @map("valid_from") @db.Date
  validTo      DateTime         @map("valid_to") @db.Date
  isActive     Boolean          @default(true) @map("is_active")
  createdById  Int?             @map("created_by")
  createdAt    DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  patient      Patient          @relation(fields: [patientId], references: [id])
  company      InsuranceCompany @relation(fields: [companyId], references: [id])
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  invoices     Invoice[]

  @@index([patientId, isActive], map: "idx_patient_insurances_patient")
  @@index([companyId])
  @@index([createdById])
  @@map("patient_insurances")
}

// ─── ინვოისები, გადახდები, სალარო ───

/// თანმიმდევრული ნომრები წლის მიხედვით (INV-2026-000001, RCP-2026-000001). იზრდება ტრანზაქციაში, FOR UPDATE-ით.
model NumberSequence {
  name      String @db.VarChar(20)
  year      Int    @db.SmallInt
  lastValue Int    @map("last_value")

  @@id([name, year])
  @@map("number_sequences")
}

/// unpaid/partial/paid პაციენტის წილისა და გადახდების მიხედვით ითვლება და გადახდისას ახლდება (იმავე ტრანზაქციაში).
enum InvoiceStatus {
  unpaid
  partial
  paid
  cancelled
}

/// ინვოისი: თანხები ინახება შექმნის მომენტის ფასებით და დაზღვევის პირობებით, შემდეგ აღარ იცვლება.
/// გადახდილი თანხა და ვალი ცალკე ველში არ ინახება — ითვლება payments-იდან.
model Invoice {
  id                      Int               @id @default(autoincrement())
  invoiceNumber           String            @unique(map: "uq_invoices_number") @map("invoice_number") @db.VarChar(20)
  patientId               Int               @map("patient_id")
  appointmentId           Int?              @map("appointment_id")
  doctorId                Int?              @map("doctor_id")
  doctorName              String?           @map("doctor_name") @db.VarChar(201)
  serviceDate             DateTime          @map("service_date") @db.DateTime(0)
  visitType               VisitType         @default(outpatient) @map("visit_type")
  status                  InvoiceStatus     @default(unpaid)
  totalAmount             Decimal           @map("total_amount") @db.Decimal(12, 2)
  discountAmount          Decimal           @map("discount_amount") @db.Decimal(12, 2)
  insuranceAmount         Decimal           @map("insurance_amount") @db.Decimal(12, 2)
  patientAmount           Decimal           @map("patient_amount") @db.Decimal(12, 2)
  patientInsuranceId      Int?              @map("patient_insurance_id")
  insuranceCompanyId      Int?              @map("insurance_company_id")
  policyNumber            String?           @map("policy_number") @db.VarChar(50)
  insuranceDisabledReason String?           @map("insurance_disabled_reason") @db.VarChar(500)
  comment                 String?           @db.Text
  cancelReason            String?           @map("cancel_reason") @db.VarChar(500)
  cancelledById           Int?              @map("cancelled_by")
  cancelledAt             DateTime?         @map("cancelled_at") @db.DateTime(0)
  createdById             Int?              @map("created_by")
  createdAt               DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  /// ძველი visits-იდან გადმოტანილი (npm run db:setup) — განმეორებით გადატანისგან დაცვა
  legacyVisitId           Int?              @unique(map: "uq_invoices_legacy_visit") @map("legacy_visit_id")
  patient                 Patient           @relation(fields: [patientId], references: [id])
  appointment             Appointment?      @relation(fields: [appointmentId], references: [id])
  doctor                  User?             @relation("InvoiceDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  patientInsurance        PatientInsurance? @relation(fields: [patientInsuranceId], references: [id])
  insuranceCompany        InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id])
  createdBy               User?             @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy             User?             @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items                   InvoiceItem[]
  payments                Payment[]
  medicalOrders           MedicalOrder[]

  @@index([patientId], map: "idx_invoices_patient")
  @@index([createdAt], map: "idx_invoices_created_at")
  @@index([status], map: "idx_invoices_status")
  @@index([appointmentId])
  @@index([insuranceCompanyId, createdAt], map: "idx_invoices_insurance")
  @@index([doctorId])
  @@index([patientInsuranceId])
  @@index([createdById])
  @@index([cancelledById])
  @@index([cancelledAt], map: "idx_invoices_cancelled_at")
  @@map("invoices")
}

/// ინვოისის ხაზი: სერვისის კოდი/დასახელება/ფასი და დაზღვევის წილი შექმნის მომენტით.
model InvoiceItem {
  id              Int      @id @default(autoincrement())
  invoiceId       Int      @map("invoice_id")
  serviceId       Int?     @map("service_id")
  serviceCode     String?  @map("service_code") @db.VarChar(30)
  serviceName     String   @map("service_name") @db.VarChar(255)
  quantity        Int      @default(1) @db.SmallInt
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountPercent Decimal  @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal  @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal  @map("total_amount") @db.Decimal(12, 2)
  insuranceAmount Decimal  @map("insurance_amount") @db.Decimal(12, 2)
  patientAmount   Decimal  @map("patient_amount") @db.Decimal(12, 2)
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  service         Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId], map: "idx_invoice_items_invoice")
  @@index([serviceId], map: "idx_invoice_items_service")
  @@map("invoice_items")
}

enum CashShiftStatus {
  open
  closed
}

/// სალაროს ცვლა. ერთ მომხმარებელს ერთი ღია ცვლა (UNIQUE გენერირებულ სვეტზე open_user_id — იხ. setup-db.ts).
model CashShift {
  id           Int             @id @default(autoincrement())
  userId       Int             @map("user_id")
  openedAt     DateTime        @default(now()) @map("opened_at") @db.DateTime(0)
  openingCash  Decimal         @map("opening_cash") @db.Decimal(12, 2)
  closedAt     DateTime?       @map("closed_at") @db.DateTime(0)
  expectedCash Decimal?        @map("expected_cash") @db.Decimal(12, 2)
  actualCash   Decimal?        @map("actual_cash") @db.Decimal(12, 2)
  difference   Decimal?        @db.Decimal(12, 2)
  closeNote    String?         @map("close_note") @db.VarChar(500)
  status       CashShiftStatus @default(open)
  user         User            @relation(fields: [userId], references: [id])
  payments     Payment[]

  @@index([userId, openedAt], map: "idx_cash_shifts_user")
  @@index([status])
  @@map("cash_shifts")
}

enum PaymentType {
  payment
  refund
}

/// გადახდის ფორმა: ნაღდი ან ბარათი
enum PaymentMethod {
  cash
  card
}

/// გადახდა ან დაბრუნება (თანხა ყოველთვის დადებითია, type განსაზღვრავს მიმართულებას). არ იცვლება და არ იშლება.
/// ბარათზე ინახება მხოლოდ ტრანზაქციის ნომერი ან ბოლო 4 ციფრი — არასოდეს სრული ნომერი.
model Payment {
  id              Int           @id @default(autoincrement())
  receiptNumber   String        @unique(map: "uq_payments_receipt") @map("receipt_number") @db.VarChar(20)
  invoiceId       Int           @map("invoice_id")
  type            PaymentType   @default(payment)
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  receivedAmount  Decimal?      @map("received_amount") @db.Decimal(12, 2)
  changeAmount    Decimal?      @map("change_amount") @db.Decimal(12, 2)
  cardReference   String?       @map("card_reference") @db.VarChar(30)
  reason          String?       @db.VarChar(500)
  cashShiftId     Int?          @map("cash_shift_id")
  createdById     Int?          @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  legacyPaymentId Int?          @unique(map: "uq_payments_legacy") @map("legacy_payment_id")
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  cashShift       CashShift?    @relation(fields: [cashShiftId], references: [id])
  createdBy       User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  prints          ReceiptPrint[]

  @@index([invoiceId], map: "idx_payments_invoice")
  @@index([createdAt], map: "idx_payments_created_at")
  @@index([cashShiftId], map: "idx_payments_cash_shift")
  @@index([createdById])
  @@map("payments")
}

enum ReceiptFormat {
  thermal
  a4
}

/// ქვითრის ბეჭდვა: პირველის შემდეგ ყველა „დუბლიკატია“.
model ReceiptPrint {
  id          Int           @id @default(autoincrement())
  paymentId   Int           @map("payment_id")
  format      ReceiptFormat
  printedById Int?          @map("printed_by")
  printedAt   DateTime      @default(now()) @map("printed_at") @db.DateTime(0)
  payment     Payment       @relation(fields: [paymentId], references: [id])
  printedBy   User?         @relation(fields: [printedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([printedById])
  @@map("receipt_prints")
}

// ─── ექიმი: სამედიცინო ჩანაწერი (EMR) ───

/// ICD-10 კლასიფიკატორი (იმპორტი CSV-დან: npm run icd10:import). code — წერტილით: "I10", "E11.9".
model Icd10Code {
  code       String               @id @db.VarChar(10)
  nameKa     String               @map("name_ka") @db.VarChar(500)
  nameEn     String?              @map("name_en") @db.VarChar(500)
  diagnoses  EncounterDiagnosis[]
  conditions PatientCondition[]

  @@index([nameKa(length: 100)], map: "idx_icd10_name_ka")
  @@index([nameEn(length: 100)], map: "idx_icd10_name_en")
  @@map("icd10_codes")
}

enum AllergySeverity {
  mild
  moderate
  severe
}

/// ალერგია — ბარათის თავში წითლად ჩანს; მედიკამენტის დანიშვნისას მოწმდება. არ იშლება — ითიშება (is_active).
model PatientAllergy {
  id          Int             @id @default(autoincrement())
  patientId   Int             @map("patient_id")
  substance   String          @db.VarChar(200)
  reaction    String?         @db.VarChar(500)
  severity    AllergySeverity @default(moderate)
  isActive    Boolean         @default(true) @map("is_active")
  createdById Int?            @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  patient     Patient         @relation(fields: [patientId], references: [id])
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId, isActive], map: "idx_patient_allergies_patient")
  @@index([createdById])
  @@map("patient_allergies")
}

/// ქრონიკული დაავადება (სურვილისამებრ ICD-10 კოდით).
model PatientCondition {
  id          Int        @id @default(autoincrement())
  patientId   Int        @map("patient_id")
  icd10Code   String?    @map("icd10_code") @db.VarChar(10)
  name        String     @db.VarChar(500)
  since       DateTime?  @db.Date
  note        String?    @db.VarChar(500)
  isActive    Boolean    @default(true) @map("is_active")
  createdById Int?       @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  patient     Patient    @relation(fields: [patientId], references: [id])
  icd10       Icd10Code? @relation(fields: [icd10Code], references: [code])
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId, isActive], map: "idx_patient_conditions_patient")
  @@index([icd10Code])
  @@index([createdById])
  @@map("patient_conditions")
}

/// მუდმივად მისაღები მედიკამენტი.
model PatientMedication {
  id          Int      @id @default(autoincrement())
  patientId   Int      @map("patient_id")
  drugName    String   @map("drug_name") @db.VarChar(200)
  dose        String?  @db.VarChar(100)
  frequency   String?  @db.VarChar(100)
  note        String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdById Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  patient     Patient  @relation(fields: [patientId], references: [id])
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId, isActive], map: "idx_patient_medications_patient")
  @@index([createdById])
  @@map("patient_medications")
}

enum EncounterStatus {
  draft
  completed
}

/// ვიზიტის სამედიცინო ჩანაწერი (გასინჯვა), ერთი ჯავშანზე. draft — ავტოშენახვით ივსება; completed — ჩაკეტილია.
/// version — ოპტიმისტური ჩაკეტვა: ორი ფანჯრიდან შენახვისას ძველი ვერსია ახალს არ გადაეწერება.
/// BMI არ ინახება — წონიდან და სიმაღლიდან ითვლება.
model Encounter {
  id               Int                  @id @default(autoincrement())
  appointmentId    Int                  @unique(map: "uq_encounters_appointment") @map("appointment_id")
  patientId        Int                  @map("patient_id")
  doctorId         Int                  @map("doctor_id")
  /// ექიმის სპეციალობა მიღების დაწყებისას — რომელი მაჩვენებლები ჩანს ფორმაში
  specialtyId      Int?                 @map("specialty_id")
  status           EncounterStatus      @default(draft)
  complaints       String?              @db.Text
  anamnesisDisease String?              @map("anamnesis_disease") @db.Text
  anamnesisLife    String?              @map("anamnesis_life") @db.Text
  examination      String?              @db.Text
  treatmentPlan    String?              @map("treatment_plan") @db.Text
  recommendations  String?              @db.Text
  bpSystolic       Int?                 @map("bp_systolic") @db.SmallInt
  bpDiastolic      Int?                 @map("bp_diastolic") @db.SmallInt
  pulse            Int?                 @db.SmallInt
  temperature      Decimal?             @db.Decimal(4, 1)
  spo2             Int?                 @db.SmallInt
  respRate         Int?                 @map("resp_rate") @db.SmallInt
  weightKg         Decimal?             @map("weight_kg") @db.Decimal(5, 1)
  heightCm         Decimal?             @map("height_cm") @db.Decimal(5, 1)
  version          Int                  @default(1)
  startedAt        DateTime             @map("started_at") @db.DateTime(0)
  updatedAt        DateTime             @map("updated_at") @db.DateTime(0)
  completedAt      DateTime?            @map("completed_at") @db.DateTime(0)
  appointment      Appointment          @relation(fields: [appointmentId], references: [id])
  patient          Patient              @relation(fields: [patientId], references: [id])
  doctor           User                 @relation("EncounterDoctor", fields: [doctorId], references: [id])
  specialty        Specialty?           @relation(fields: [specialtyId], references: [id])
  measurements     EncounterMeasurement[]
  diagnoses        EncounterDiagnosis[]
  prescriptions    Prescription[]
  orders           MedicalOrder[]
  documents        MedicalDocument[]

  @@index([patientId, startedAt], map: "idx_encounters_patient")
  @@index([doctorId, startedAt], map: "idx_encounters_doctor")
  @@index([status])
  @@index([specialtyId])
  @@map("encounters")
}

/// დიაგნოზი ICD-10-ით: ერთი ძირითადი (is_primary) და თანმხლებები.
model EncounterDiagnosis {
  id          Int       @id @default(autoincrement())
  encounterId Int       @map("encounter_id")
  icd10Code   String    @map("icd10_code") @db.VarChar(10)
  isPrimary   Boolean   @default(false) @map("is_primary")
  /// გართულება (ფორმა 100: „ძირითადი / გართულება / თანმხლები“)
  isComplication Boolean @default(false) @map("is_complication")
  note        String?   @db.VarChar(500)
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  icd10       Icd10Code @relation(fields: [icd10Code], references: [code])

  @@unique([encounterId, icd10Code], map: "uq_encounter_diagnoses")
  @@index([icd10Code], map: "idx_encounter_diagnoses_code")
  @@map("encounter_diagnoses")
}

enum TemplateField {
  complaints
  anamnesis_disease
  anamnesis_life
  examination
  treatment_plan
  recommendations
}

/// ექიმის შაბლონი (ხშირად გამოყენებადი ტექსტი) ფორმის კონკრეტული ველისთვის.
model DoctorTemplate {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  field     TemplateField
  title     String        @db.VarChar(100)
  content   String        @db.Text
  createdAt DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, field], map: "idx_doctor_templates_user")
  @@map("doctor_templates")
}

/// რეცეპტი (მედიკამენტის დანიშნულება).
model Prescription {
  id          Int       @id @default(autoincrement())
  encounterId Int       @map("encounter_id")
  patientId   Int       @map("patient_id")
  drugName    String    @map("drug_name") @db.VarChar(200)
  dose        String    @db.VarChar(100)
  form        String?   @db.VarChar(100)
  frequency   String    @db.VarChar(100)
  duration    String?   @db.VarChar(100)
  note        String?   @db.VarChar(500)
  quantity    Int?      @db.SmallInt
  rxNumber    String?   @map("rx_number") @db.VarChar(50)
  createdById Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  encounter   Encounter @relation(fields: [encounterId], references: [id])
  patient     Patient   @relation(fields: [patientId], references: [id])
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([encounterId])
  @@index([patientId, createdAt], map: "idx_prescriptions_patient")
  @@index([createdById])
  @@map("prescriptions")
}

/// lab — ლაბორატორია, instrumental — ექო/რენტგენი და ა.შ. (ლაბორანტის გვერდი), procedure — ექთნის პროცედურა.
enum OrderType {
  lab
  instrumental
  procedure
}

/// lab/instrumental: ordered → sample_taken → ready; procedure: ordered → done. cancelled — ნებისმიერიდან.
enum OrderStatus {
  ordered
  sample_taken
  ready
  done
  cancelled
}

/// დანიშნულება (კვლევა ან პროცედურა) — არსებული სერვისიდან, რომ ფასი ფინანსებში გადავიდეს.
/// შედეგი: result_text და/ან ფაილი (patient_documents).
model MedicalOrder {
  id               Int              @id @default(autoincrement())
  encounterId      Int              @map("encounter_id")
  patientId        Int              @map("patient_id")
  type             OrderType
  serviceId        Int              @map("service_id")
  serviceName      String           @map("service_name") @db.VarChar(255)
  status           OrderStatus      @default(ordered)
  note             String?          @db.VarChar(500)
  resultText       String?          @map("result_text") @db.Text
  resultDocumentId Int?             @map("result_document_id")
  createdById      Int?             @map("created_by")
  createdAt        DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  performedById    Int?             @map("performed_by")
  performedAt      DateTime?        @map("performed_at") @db.DateTime(0)
  updatedAt        DateTime         @map("updated_at") @db.DateTime(0)
  /// ინვოისი, რომელშიც ეს დანიშნულება ჩაჯდა (ვიზიტის დასრულებისას) — ორჯერ არ დაერიცხება
  invoiceId        Int?             @map("invoice_id")
  encounter        Encounter        @relation(fields: [encounterId], references: [id])
  invoice          Invoice?         @relation(fields: [invoiceId], references: [id])
  patient          Patient          @relation(fields: [patientId], references: [id])
  service          Service          @relation(fields: [serviceId], references: [id])
  resultDocument   PatientDocument? @relation(fields: [resultDocumentId], references: [id])
  createdBy        User?            @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  performedBy      User?            @relation("OrderPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]

  @@index([type, status, createdAt], map: "idx_medical_orders_queue")
  @@index([patientId, createdAt], map: "idx_medical_orders_patient")
  @@index([encounterId])
  @@index([serviceId])
  @@index([resultDocumentId])
  @@index([createdById])
  @@index([performedById])
  @@index([invoiceId])
  @@map("medical_orders")
}

enum MedicalDocumentType {
  visit_summary
  certificate_100
  prescription
  referral
  sick_leave
  consent
}

/// draft → signed (ჩაკეტილი) → superseded (ახალმა ვერსიამ ჩაანაცვლა). ცვლილება — მხოლოდ ახალი ვერსიით (previous_id).
enum MedicalDocumentStatus {
  draft
  signed
  superseded
}

/// სამედიცინო დოკუმენტი: content — ფორმის მონაცემები (JSON), PDF — patient_documents-ში (ხელმოწერისას), sha256 — მთლიანობა.
model MedicalDocument {
  id            Int                   @id @default(autoincrement())
  patientId     Int                   @map("patient_id")
  encounterId   Int?                  @map("encounter_id")
  type          MedicalDocumentType
  version       Int                   @default(1)
  previousId    Int?                  @unique(map: "uq_medical_documents_previous") @map("previous_id")
  status        MedicalDocumentStatus @default(draft)
  title         String                @db.VarChar(255)
  content       String                @db.Text
  pdfDocumentId Int?                  @map("pdf_document_id")
  sha256        String?               @db.Char(64)
  /// დოკუმენტის ნომერი (ფორმა 100 — ცნობის №), ენიჭება ხელმოწერისას
  docNumber     String?               @map("doc_number") @db.VarChar(30)
  createdById   Int?                  @map("created_by")
  createdAt     DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  signedAt      DateTime?             @map("signed_at") @db.DateTime(0)
  patient       Patient               @relation(fields: [patientId], references: [id])
  encounter     Encounter?            @relation(fields: [encounterId], references: [id])
  previous      MedicalDocument?      @relation("DocumentVersions", fields: [previousId], references: [id])
  next          MedicalDocument?      @relation("DocumentVersions")
  pdf           PatientDocument?      @relation(fields: [pdfDocumentId], references: [id])
  createdBy     User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  signatures    DocumentSignature[]

  @@index([patientId, createdAt], map: "idx_medical_documents_patient")
  @@index([encounterId])
  @@index([pdfDocumentId])
  @@index([createdById])
  @@map("medical_documents")
}

enum SignerRole {
  doctor
  patient
  head
}

/// ხელმოწერა: სურათი (PNG) დისკზე, device — საიდან (canvas ან მოწყობილობის SDK-ის სახელი).
model DocumentSignature {
  id           Int             @id @default(autoincrement())
  documentId   Int             @map("document_id")
  signerRole   SignerRole      @map("signer_role")
  signerName   String          @map("signer_name") @db.VarChar(201)
  signerUserId Int?            @map("signer_user_id")
  /// null — ხელით, დაბეჭდილზე (device = "manual")
  imagePath    String?         @map("image_path") @db.VarChar(255)
  device       String          @db.VarChar(50)
  signedAt     DateTime        @map("signed_at") @db.DateTime(0)
  document     MedicalDocument @relation(fields: [documentId], references: [id])
  signerUser   User?           @relation(fields: [signerUserId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([signerUserId])
  @@map("document_signatures")
}

/// შეტყობინება მომხმარებელს (მზა ლაბ. შედეგი, პაციენტი მოვიდა, პროცედურა შესრულდა). read_at NULL — წაუკითხავი.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String    @db.VarChar(30)
  title     String    @db.VarChar(200)
  body      String?   @db.VarChar(500)
  link      String?   @db.VarChar(255)
  readAt    DateTime? @map("read_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt], map: "idx_notifications_user")
  @@map("notifications")
}

/// აუდიტი: ვინ, როდის, რომელი პაციენტის ჩანაწერი ნახა/შეცვალა/ხელი მოაწერა. მხოლოდ ემატება.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(30)
  entity    String   @db.VarChar(30)
  entityId  Int?     @map("entity_id")
  patientId Int?     @map("patient_id")
  details   String?  @db.VarChar(500)
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  patient   Patient? @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt], map: "idx_audit_log_patient")
  @@index([userId, createdAt], map: "idx_audit_log_user")
  @@index([createdAt], map: "idx_audit_log_created")
  @@map("audit_log")
}

// ─── სპეციალობის მაჩვენებლები (ადმინი ამატებს, რაოდენობა შეუზღუდავია) ───

enum MeasurementType {
  number
  text
  select
  boolean
}

/// none — ერთი მნიშვნელობა; eyes — OD/OS; limbs — მარჯვენა/მარცხენა
enum MeasurementSides {
  none
  eyes
  limbs
}

enum MeasurementSide {
  none
  right
  left
}

/// მაჩვენებლების ცნობარი (ერთი მაჩვენებელი რამდენიმე სპეციალობას შეიძლება ჰქონდეს)
model MeasurementDefinition {
  id         Int              @id @default(autoincrement())
  name       String           @unique(map: "uq_measurement_definitions_name") @db.VarChar(150)
  unit       String?          @db.VarChar(30)
  type       MeasurementType  @default(number)
  sides      MeasurementSides @default(none)
  /// რიცხვის დასაშვები ფარგლები (შეყვანის შეცდომისგან დაცვა) და ნორმა (↑/↓ ნიშანი)
  minValue   Decimal?         @map("min_value") @db.Decimal(14, 4)
  maxValue   Decimal?         @map("max_value") @db.Decimal(14, 4)
  normalMin  Decimal?         @map("normal_min") @db.Decimal(14, 4)
  normalMax  Decimal?         @map("normal_max") @db.Decimal(14, 4)
  decimals   Int              @default(0) @db.TinyInt
  /// არჩევანის ვარიანტები (select) — JSON მასივი
  options    String?          @db.Text
  createdAt  DateTime         @map("created_at") @db.DateTime(0)
  updatedAt  DateTime         @map("updated_at") @db.DateTime(0)
  specialties SpecialtyMeasurement[]
  values      EncounterMeasurement[]

  @@map("measurement_definitions")
}

/// სპეციალობის მაჩვენებლების ნაკრები: რიგი, სავალდებულოა თუ არა (ვიზიტის დასრულებისას)
model SpecialtyMeasurement {
  specialtyId  Int                   @map("specialty_id")
  definitionId Int                   @map("definition_id")
  sortOrder    Int                   @default(0) @map("sort_order")
  required     Boolean               @default(false)
  specialty    Specialty             @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  definition   MeasurementDefinition @relation(fields: [definitionId], references: [id])

  @@id([specialtyId, definitionId])
  @@index([definitionId])
  @@map("specialty_measurements")
}

/// ვიზიტის მაჩვენებლების მნიშვნელობები (რიცხვი — value_num, დანარჩენი — value_text)
model EncounterMeasurement {
  id           Int                   @id @default(autoincrement())
  encounterId  Int                   @map("encounter_id")
  patientId    Int                   @map("patient_id")
  definitionId Int                   @map("definition_id")
  side         MeasurementSide       @default(none)
  valueNum     Decimal?              @map("value_num") @db.Decimal(14, 4)
  valueText    String?               @map("value_text") @db.VarChar(500)
  encounter    Encounter             @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patient      Patient               @relation(fields: [patientId], references: [id])
  definition   MeasurementDefinition @relation(fields: [definitionId], references: [id])

  @@unique([encounterId, definitionId, side], map: "uq_encounter_measurements")
  @@index([patientId, definitionId, encounterId], map: "idx_encounter_measurements_trend")
  @@index([definitionId])
  @@map("encounter_measurements")
}

// ─── შიდა ჩატი (src/modules/chat/) ───

enum ConversationType {
  direct
  group
}

enum ConversationMemberRole {
  owner
  member
}

enum MessageKind {
  text
  system
}

enum MessageRevisionAction {
  edit
  delete
}

enum ManualPresenceStatus {
  dnd
}

/// საუბარი. direct_key = "<მცირე id>:<დიდი id>" — ორ ადამიანს შორის ერთი პირადი საუბარი (ჯგუფში NULL).
/// last_message_id/at — სიის დალაგება და ბოლო შეტყობინების ნაწყვეტი ერთი მოთხოვნით.
model Conversation {
  id            Int                  @id @default(autoincrement())
  type          ConversationType
  name          String?              @db.VarChar(100)
  directKey     String?              @unique(map: "uq_conversations_direct_key") @map("direct_key") @db.VarChar(23)
  createdById   Int?                 @map("created_by")
  createdAt     DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  lastMessageId BigInt?              @map("last_message_id")
  lastMessageAt DateTime?            @map("last_message_at") @db.DateTime(0)
  createdBy     User?                @relation("ConversationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members       ConversationMember[]
  messages      Message[]

  @@index([createdById], map: "idx_conversations_created_by")
  @@map("conversations")
}

/// საუბრის მონაწილე. წაუკითხავი = შეტყობინებები id > last_read_message_id (სხვისი). გასვლისას ჩანაწერი იშლება.
/// cleared_message_id — „საუბრის წაშლა ჩემთვის“: ამ id-მდე შეტყობინებები მონაწილეს აღარ უჩანს (ბაზაში რჩება).
model ConversationMember {
  conversationId    Int                    @map("conversation_id")
  userId            Int                    @map("user_id")
  role              ConversationMemberRole @default(member)
  joinedAt          DateTime               @default(now()) @map("joined_at") @db.DateTime(0)
  lastReadMessageId BigInt                 @default(0) @map("last_read_message_id")
  clearedMessageId  BigInt                 @default(0) @map("cleared_message_id")
  muted             Boolean                @default(false)
  pinned            Boolean                @default(false)
  conversation      Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId], map: "idx_conversation_members_user")
  @@map("conversation_members")
}

/// შეტყობინება. მომხმარებლის წაშლა — deleted_at (ფიზიკურად არ იშლება); ძველი ტექსტი — message_revisions.
/// ფიზიკურად იშლება მხოლოდ ადმინის გასუფთავებით (admin/chat — src/modules/chat/server/retention.ts).
/// kind = system: ჯგუფის მოვლენა (event, target_user_id). client_id — კლიენტის UUID (განმეორებითი გაგზავნა დუბლიკატს არ ქმნის).
model Message {
  id             BigInt              @id @default(autoincrement())
  conversationId Int                 @map("conversation_id")
  senderId       Int                 @map("sender_id")
  kind           MessageKind         @default(text)
  body           String?             @db.Text
  event          String?             @db.VarChar(30)
  targetUserId   Int?                @map("target_user_id")
  replyToId      BigInt?             @map("reply_to_id")
  clientId       String?             @map("client_id") @db.Char(36)
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  editedAt       DateTime?           @map("edited_at") @db.DateTime(0)
  deletedAt      DateTime?           @map("deleted_at") @db.DateTime(0)
  conversation   Conversation        @relation(fields: [conversationId], references: [id])
  sender         User                @relation("MessageSender", fields: [senderId], references: [id])
  targetUser     User?               @relation("MessageTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  replyTo        Message?            @relation("MessageReply", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies        Message[]           @relation("MessageReply")
  attachments    MessageAttachment[]
  revisions      MessageRevision[]

  @@unique([senderId, clientId], map: "uq_messages_client")
  @@index([conversationId, id], map: "idx_messages_conversation")
  @@index([senderId], map: "idx_messages_sender")
  @@index([replyToId], map: "idx_messages_reply_to")
  @@index([targetUserId], map: "idx_messages_target_user")
  @@map("messages")
}

/// შეტყობინების ტექსტის წინა ვერსია რედაქტირებისა და წაშლისას. მხოლოდ ემატება.
model MessageRevision {
  id        BigInt                @id @default(autoincrement())
  messageId BigInt                @map("message_id")
  action    MessageRevisionAction
  oldBody   String?               @map("old_body") @db.Text
  userId    Int?                  @map("user_id")
  createdAt DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  message   Message               @relation(fields: [messageId], references: [id])
  user      User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([messageId], map: "idx_message_revisions_message")
  @@index([userId], map: "idx_message_revisions_user")
  @@map("message_revisions")
}

/// მიმაგრებული ფაილი: თვითონ ფაილი დისკზეა (DOCUMENTS_DIR/chat/...), იკითხება მხოლოდ საუბრის მონაწილისთვის.
model MessageAttachment {
  id          BigInt  @id @default(autoincrement())
  messageId   BigInt  @map("message_id")
  fileName    String  @map("file_name") @db.VarChar(255)
  mimeType    String  @map("mime_type") @db.VarChar(100)
  size        Int
  storagePath String  @map("storage_path") @db.VarChar(255)
  width       Int?    @db.SmallInt
  height      Int?    @db.SmallInt
  message     Message @relation(fields: [messageId], references: [id])

  @@index([messageId], map: "idx_message_attachments_message")
  @@map("message_attachments")
}

model UserFavorite {
  userId         Int      @map("user_id")
  favoriteUserId Int      @map("favorite_user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  user           User     @relation("FavoriteOwner", fields: [userId], references: [id], onDelete: Cascade)
  favoriteUser   User     @relation("FavoriteTarget", fields: [favoriteUserId], references: [id], onDelete: Cascade)

  @@id([userId, favoriteUserId])
  @@index([favoriteUserId], map: "idx_user_favorites_favorite")
  @@map("user_favorites")
}

/// მიმდინარე სტატუსი სოკეტის კავშირებიდან ითვლება (მეხსიერებაში); აქ — „არ შემაწუხოთ“ და ბოლო აქტივობის/ყოფნის დრო.
model UserPresence {
  userId       Int                   @id @map("user_id")
  manualStatus ManualPresenceStatus? @map("manual_status")
  lastActiveAt DateTime?             @map("last_active_at") @db.DateTime(0)
  lastSeenAt   DateTime?             @map("last_seen_at") @db.DateTime(0)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_presence")
}

model UserChatSettings {
  userId               Int     @id @map("user_id")
  soundEnabled         Boolean @default(true) @map("sound_enabled")
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_chat_settings")
}

// ─── საწყობი (src/modules/inventory/) ───

enum InventoryCategory {
  medication
  consumable
  reagent
}

/// receipt — შემოსავალი (+), consumption — გახარჯვა (−), writeoff — ჩამოწერა მიზეზით (−), adjustment — ინვენტარიზაცია (±)
enum InventoryMovementType {
  receipt
  consumption
  writeoff
  adjustment
}

enum InventoryWriteoffReason {
  expired
  damaged
  lost
  other
}

model InventorySupplier {
  id        Int                @id @default(autoincrement())
  name      String             @unique(map: "uq_inventory_suppliers_name") @db.VarChar(200)
  taxId     String?            @map("tax_id") @db.VarChar(20)
  phone     String?            @db.VarChar(50)
  note      String?            @db.VarChar(500)
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  receipts  InventoryReceipt[]

  @@map("inventory_suppliers")
}

/// დასახელება კატალოგში. არ იშლება — ითიშება (მოძრაობების ისტორიაში რჩება). min_quantity — გაფრთხილების ზღვარი (0 — გარეშე).
model InventoryItem {
  id           Int                 @id @default(autoincrement())
  name         String              @unique(map: "uq_inventory_items_name") @db.VarChar(200)
  category     InventoryCategory
  unit         String              @db.VarChar(20)
  minQuantity  Decimal             @default(0) @map("min_quantity") @db.Decimal(12, 2)
  tracksExpiry Boolean             @default(true) @map("tracks_expiry")
  note         String?             @db.VarChar(500)
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @map("created_at") @db.DateTime(0)
  updatedAt    DateTime            @map("updated_at") @db.DateTime(0)
  batches      InventoryBatch[]
  movements    InventoryMovement[]
  serviceNorms ServiceMaterial[]

  @@index([category, isActive], map: "idx_inventory_items_category")
  @@map("inventory_items")
}

/// შემოსავლის დოკუმენტი (ზედნადები): რამდენიმე პარტია ერთ მომწოდებლისგან.
model InventoryReceipt {
  id             Int                 @id @default(autoincrement())
  supplierId     Int?                @map("supplier_id")
  documentNumber String?             @map("document_number") @db.VarChar(50)
  receivedOn     DateTime            @map("received_on") @db.Date
  note           String?             @db.VarChar(500)
  createdById    Int?                @map("created_by")
  createdAt      DateTime            @map("created_at") @db.DateTime(0)
  supplier       InventorySupplier?  @relation(fields: [supplierId], references: [id])
  createdBy      User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  batches        InventoryBatch[]
  movements      InventoryMovement[]

  @@index([receivedOn], map: "idx_inventory_receipts_received")
  @@index([supplierId], map: "idx_inventory_receipts_supplier")
  @@index([createdById], map: "idx_inventory_receipts_created_by")
  @@map("inventory_receipts")
}

/// პარტია: ნაშთი (quantity) მცირდება გახარჯვით; ვადა/სერია/ფასი — შემოსავლიდან. გახარჯვა FEFO-თი (stock.ts).
model InventoryBatch {
  id               Int                 @id @default(autoincrement())
  itemId           Int                 @map("item_id")
  receiptId        Int?                @map("receipt_id")
  lotNumber        String?             @map("lot_number") @db.VarChar(50)
  expiryDate       DateTime?           @map("expiry_date") @db.Date
  unitCost         Decimal?            @map("unit_cost") @db.Decimal(12, 2)
  receivedQuantity Decimal             @map("received_quantity") @db.Decimal(12, 2)
  quantity         Decimal             @db.Decimal(12, 2)
  createdAt        DateTime            @map("created_at") @db.DateTime(0)
  item             InventoryItem       @relation(fields: [itemId], references: [id])
  receipt          InventoryReceipt?   @relation(fields: [receiptId], references: [id])
  movements        InventoryMovement[]

  @@index([itemId, expiryDate], map: "idx_inventory_batches_item")
  @@index([expiryDate], map: "idx_inventory_batches_expiry")
  @@index([receiptId], map: "idx_inventory_batches_receipt")
  @@map("inventory_batches")
}

/// მოძრაობა (ჟურნალი): quantity — ნიშნით (+ შემოსავალი, − გასავალი). არ იცვლება და არ იშლება.
model InventoryMovement {
  id             BigInt                   @id @default(autoincrement())
  itemId         Int                      @map("item_id")
  batchId        Int                      @map("batch_id")
  type           InventoryMovementType
  quantity       Decimal                  @db.Decimal(12, 2)
  reason         InventoryWriteoffReason?
  note           String?                  @db.VarChar(500)
  receiptId      Int?                     @map("receipt_id")
  patientId      Int?                     @map("patient_id")
  medicalOrderId Int?                     @map("medical_order_id")
  createdById    Int?                     @map("created_by")
  createdAt      DateTime                 @map("created_at") @db.DateTime(0)
  item           InventoryItem            @relation(fields: [itemId], references: [id])
  batch          InventoryBatch           @relation(fields: [batchId], references: [id])
  receipt        InventoryReceipt?        @relation(fields: [receiptId], references: [id])
  patient        Patient?                 @relation(fields: [patientId], references: [id])
  medicalOrder   MedicalOrder?            @relation(fields: [medicalOrderId], references: [id])
  createdBy      User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt], map: "idx_inventory_movements_item")
  @@index([createdAt], map: "idx_inventory_movements_created")
  @@index([batchId], map: "idx_inventory_movements_batch")
  @@index([receiptId], map: "idx_inventory_movements_receipt")
  @@index([patientId], map: "idx_inventory_movements_patient")
  @@index([medicalOrderId], map: "idx_inventory_movements_order")
  @@index([createdById], map: "idx_inventory_movements_created_by")
  @@map("inventory_movements")
}

/// სერვისის ნორმა: ერთ შესრულებაზე გასახარჯი მასალა (ექთანი/ლაბორანტი შესრულებისას ხედავს და ასწორებს).
model ServiceMaterial {
  serviceId Int           @map("service_id")
  itemId    Int           @map("item_id")
  quantity  Decimal       @db.Decimal(12, 2)
  service   Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id])

  @@id([serviceId, itemId])
  @@index([itemId], map: "idx_service_materials_item")
  @@map("service_materials")
}

/// შესვლის მცდელობები (src/lib/login-guard.ts): დაბლოკვა ზედიზედ წარუმატებელი ცდების შემდეგ.
enum LoginAttemptKind {
  failed
  blocked
  success
  unlock
}

model LoginAttempt {
  id        BigInt           @id @default(autoincrement())
  username  String           @db.VarChar(50)
  ip        String?          @db.VarChar(45)
  kind      LoginAttemptKind
  createdAt DateTime         @map("created_at") @db.DateTime(3)

  @@index([username, createdAt], map: "idx_login_attempts_username")
  @@index([ip, createdAt], map: "idx_login_attempts_ip")
  @@index([createdAt], map: "idx_login_attempts_created")
  @@map("login_attempts")
}
